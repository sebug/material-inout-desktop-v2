<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="material_inout_desktop_v2.Pages.VoucherDetailPage"
             xmlns:vm="clr-namespace:material_inout_desktop_v2.ViewModels"
             xmlns:views="clr-namespace:material_inout_desktop_v2.Views"
             Title="{Binding Title}"
             x:DataType="vm:VoucherDetailViewModel">
    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="25">
            <Button 
            Text="Retourner"
            Command="{Binding ReturnMaterialCommand}"
            IsVisible="{Binding ShowReturnMaterial}"
             />


    <views:MyWebView HeightRequest="600" x:Name="voucherDetailWebView" HandlerChanged="voucherDetailWebView_HandlerChanged">
        <views:MyWebView.Source>
            <HtmlWebViewSource Html="{Binding HTMLContent}"></HtmlWebViewSource>
        </views:MyWebView.Source>
    </views:MyWebView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>